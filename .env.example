# ==========================================================
# EntradaPro — Modelo de variáveis de ambiente
# ==========================================================
# Este arquivo é só um MODELO. Não contém segredos reais.
# Copie este arquivo para um novo arquivo chamado ".env"
# (na mesma pasta) e preencha os valores reais lá.
#
# O arquivo ".env" (com os valores de verdade) NUNCA deve
# ser enviado ao Git — ele já está protegido no .gitignore.
# ==========================================================

# Chave da API-Football (https://dashboard.api-football.com)
API_FOOTBALL_KEY=

# Mercado Pago — assinatura secreta do webhook
# (Painel Mercado Pago > Suas integrações > Webhooks)
MERCADO_PAGO_WEBHOOK_SECRET=

# Mercado Pago — credenciais de TESTE (sandbox)
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_TEST_PUBLIC_KEY=

# Mercado Pago — ambiente ativo: "teste" ou "producao"
MERCADO_PAGO_AMBIENTE=teste

# Mercado Pago — ID do plano mensal (ambiente de teste)
MERCADO_PAGO_TEST_PLANO_MENSAL_ID=

# ==========================================================
# As variáveis abaixo serão adicionadas quando o projeto
# migrar para o Mercado Pago em modo produção (Etapa 6):
#
# MERCADO_PAGO_PROD_ACCESS_TOKEN=
# MERCADO_PAGO_PROD_PUBLIC_KEY=
# MERCADO_PAGO_PROD_PLANO_MENSAL_ID=
# MERCADO_PAGO_PROD_PLANO_TRIMESTRAL_ID=
# MERCADO_PAGO_PROD_PLANO_ANUAL_ID=
# ==========================================================
